<mxfile host="app.diagrams.net" agent="compliance framework" version="24.7.17"><diagram id="p8" name="9 EXPORT_LOAD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="EXPORT_LOAD – core to the export table (runbook 2.8, 5.11)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry" /></mxCell><mxCell id="s" value="EXPORT_LOAD run (scope, batch, release, hold)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="320" height="50" as="geometry" /></mxCell><mxCell id="sel" value="Batches: every open batch of the scope (each run),&lt;br&gt;closed batches with new data since their last&lt;br&gt;export (late arrival, correction), or the batches named" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="320" height="80" as="geometry" /></mxCell><mxCell id="due" value="Due (close date, RELEASE_TIME)&lt;br&gt;or released, run type&lt;br&gt;not held?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="270" width="220" height="100" as="geometry" /></mxCell><mxCell id="held" value="held: listed in the report,&lt;br&gt;exported when due or released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="440" y="290" width="280" height="60" as="geometry" /></mxCell><mxCell id="new" value="Newest batch of its period&lt;br&gt;(NEW_FILE / CARRY_FORWARD&lt;br&gt;/ NO_DATA)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="410" width="220" height="100" as="geometry" /></mxCell><mxCell id="sk" value="SKIPPED: the period's data&lt;br&gt;is another batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="430" width="280" height="60" as="geometry" /></mxCell><mxCell id="pre" value="Exp_Pre_Sql_Txt (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="320" height="50" as="geometry" /></mxCell><mxCell id="how" value="How is it exported?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="640" width="220" height="90" as="geometry" /></mxCell><mxCell id="m1" value="Procedure Exp_Proc_Nm&lt;br&gt;CALL with Exp_Proc_Parm_Txt;&lt;br&gt;it deletes and inserts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="240" height="80" as="geometry" /></mxCell><mxCell id="m2" value="Exp_Sql_Txt SELECT:&lt;br&gt;the source's period rows removed,&lt;br&gt;the SELECT's rows inserted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="780" width="240" height="80" as="geometry" /></mxCell><mxCell id="m3" value="Plain copy: the source's period rows&lt;br&gt;removed, the batch's core rows&lt;br&gt;inserted (columns mapped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="780" width="240" height="80" as="geometry" /></mxCell><mxCell id="post" value="Exp_Post_Sql_Txt (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="320" height="50" as="geometry" /></mxCell><mxCell id="ok" value="Succeeded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="990" width="220" height="90" as="geometry" /></mxCell><mxCell id="bad" value="Rolled back: EXPORT_LOAD_FAILED&lt;br&gt;(emailed), exit 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="440" y="1005" width="280" height="60" as="geometry" /></mxCell><mxCell id="done" value="EXPORT_LOADED in the timeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="320" height="50" as="geometry" /></mxCell><mxCell id="ru" value="trigger FILE_RULES (and wait for it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="320" height="50" as="geometry" /></mxCell><mxCell id="n" value="Pre, every source's export and post run as one transaction per batch.&lt;br&gt;A source without data yet: its earlier rows of the period are removed, none inserted&lt;br&gt;(with a procedure, the procedure is called for it)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1110" width="460" height="80" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="sel"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sel" target="due"><mxGeometry relative="1" as="geometry" /></m