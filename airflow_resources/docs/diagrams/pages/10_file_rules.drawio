<mxfile host="app.diagrams.net" agent="Government Regulatory framework" version="24.7.17"><diagram id="p9" name="10 FILE_RULES"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="FILE_RULES – data quality rules of each exported batch (runbook 2.12)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry" /></mxCell><mxCell id="s" value="FILE_RULES run (scope), pool gre_rules" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="50" as="geometry" /></mxCell><mxCell id="sel" value="Loads FILE_LOADED whose Rules_Stat is&lt;br&gt;NOT_RUN or ERROR, by batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="60" as="geometry" /></mxCell><mxCell id="exp" value="Table has an export:&lt;br&gt;batch exported since&lt;br&gt;the load?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="220" height="100" as="geometry" /></mxCell><mxCell id="expw" value="waiting for EXPORT_LOAD (logged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="430" y="270" width="280" height="60" as="geometry" /></mxCell><mxCell id="lk" value="Batch free?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="220" height="90" as="geometry" /></mxCell><mxCell id="lkw" value="left for the next run (logged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;