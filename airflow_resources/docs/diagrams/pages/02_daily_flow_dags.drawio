<mxfile host="app.diagrams.net" agent="Government Regulatory framework" version="24.7.17"><diagram id="p1" name="2 Daily flow (DAGs)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The daily flow – DAGs and triggers (runbook 2, 2.1)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry" /></mxCell><mxCell id="bc" value="BATCH_CREATION&lt;br&gt;daily 06:00, and after BATCH_CLOSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="70" width="280" height="60" as="geometry" /></mxCell><mxCell id="fc" value="FILE_CHECK (optional)&lt;br&gt;e.g. every 15 min; loads nothing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="260" height="60" as="geometry" /></mxCell><mxCell id="fl" value="FILE_LOAD&lt;br&gt;hourly, or after FILE_CHECK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="310" width="260" height="60" as="geometry" /></mxCell><mxCell id="sl" value="SOURCE_LOAD&lt;br&gt;e.g. 06:30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="310" width="260" height="60" as="geometry" /></mxCell><mxCell id="od" value="OVERRIDE_DECISIONS&lt;br&gt;after FILE_LOAD (or scheduled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="260" height="60" as="geometry" /></mxCell><mxCell id="ex" value="EXPORT_LOAD&lt;br&gt;after the loads, and 20:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="440" width="260" height="60" as="geometry" /></mxCell><mxCell id="ru" value="FILE_RULES&lt;br&gt;started by EXPORT_LOAD, which waits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="570" width="260" height="60" as="geometry" /></mxCell><mxCell id="cl" value="BATCH_CLOSE&lt;br&gt;nightly 22:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="570" width="260" height="60" as="geometry" /></mxCell><mxCell id="no" value="NOTIFY&lt;br&gt;after BATCH_CLOSE, and hourly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="690" width="260" height="60" as="geometry" /></mxCell><mxCell id="n" value="Solid arrow = trigger_dags in the Variable (only on success, exit 0). Dashed = must happen before.&lt;br&gt;Keep FILE_LOAD out of the window between BATCH_CLOSE and BATCH_CREATION.&lt;br&gt;Every DAG also runs on its own schedule_interval; until it is set, a chain starts only when triggered by hand." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="900" height="70" as="geometry" /></mxCell><mxCell id="e0" value="batches exist first" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bc" target="fc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bc" target="sl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="trigger (a file passed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fc" target="fl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fl" target="od"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fl" target="ex"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="340" /></Array></mxGeometry></mxCell><mxCell id="e5" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sl" target="ex"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="470" /></Array></mxGeometry></mxCell><mxCell id="e6" value="trigger + wait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="ru"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="trigger (next day's batches)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl" target="bc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="600" /><mxPoint x="990" y="100" /></Array></mxGeometry></mxCell><mxCell id="e8" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl" target="no"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
