<mxfile host="app.diagrams.net" agent="Government Regulatory framework" version="24.7.17"><diagram id="p6" name="7 SOURCE_LOAD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SOURCE_LOAD – internal sources by query (runbook 2.6)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry" /></mxCell><mxCell id="s" value="SOURCE_LOAD run (scope, batch, release, hold)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="50" as="geometry" /></mxCell><mxCell id="sel" value="Open batches whose source has a&lt;br&gt;GOVT_RGLTRY_InternalSourceConfig row&lt;br&gt;(or the batches named)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="70" as="geometry" /></mxCell><mxCell id="hold" value="Run type held?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="220" height="90" as="geometry" /></mxCell><mxCell id="holds" value="held: listed in the report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="430" y="275" width="260" height="60" as="geometry" /></mxCell><mxCell id="busy" value="Staging table free?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="220" height="90" as="geometry" /></mxCell><mxCell id="busyw" value="LOAD_INCOMPLETE: next run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex