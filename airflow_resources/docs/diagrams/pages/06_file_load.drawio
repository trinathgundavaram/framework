<mxfile host="app.diagrams.net" agent="Government Regulatory framework" version="24.7.17"><diagram id="p5" name="6 FILE_LOAD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="FILE_LOAD – from the NAS to core, file by file (runbook 2.5, 5.7)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry" /></mxCell><mxCell id="s" value="FILE_LOAD run (scope, or one file)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="50" as="geometry" /></mxCell><mxCell id="ls" value="List the inbound folders of the scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="60" as="geometry" /></mxCell><mxCell id="age" value="Still arriving?&lt;br&gt;(NAS_MIN_AGE_SECONDS)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="220" height="90" as="geometry" /></mxCell><mxCell id="agew" value="Left for the next run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="430" y="265" width="280" height="60" as="geometry" /></mxCell><mxCell id="own" value="The scope's file?&lt;br&gt;(shared folder, run type,&lt;br&gt;another project's)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="220" height="90" as="geometry" /></mxCell><mxCell id="owns" value="skipped: reason in the log&lt;br&gt;and in skipped_files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="430" y="395" width="280" height="60" as="geometry" /></mxCell><mxCell id="gone" value="Still in the folder,&lt;br&gt;not loaded before?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="220" height="90" as="geometry" /></mxCell><mxCell id="gones" value="skipped: moved by another run,&lt;br&gt;or only the move to Archive / Error retried" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="430" y="525" width="280" height="60" as="geometry" /></mxCell><mxCell id="reg" value="GOVT_RGLTRY_FileLoad row: RECEIVED&lt;br&gt;name → file config → batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="300" height="60" as="geometry" /></mxCell><mxCell id="bat" value="Open batch for its run type&lt;br&gt;and dates? (closed: approved&lt;br&gt;LATE_ARRIVAL / CORRECTION)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="740" width="220" height="100" as="geometry" /></mxCell><mxCell id="batr" value="REJECTED&lt;br&gt;FILE_REJECTED_NO_BATCH / _BATCH_CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="760" width="280" height="60" as="geometry" /></mxCell><mxCell id="chk" value="Content checks pass?&lt;br&gt;(CHECK_ON_LOAD)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="880" width="220" height="90" as="geometry" /></mxCell><mxCell id="chkr" value="REJECTED&lt;br&gt;FILE_CONTENT_CHECK_FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="895" width="280" height="60" as="geometry" /></mxCell><mxCell id="busy" value="Staging table free?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="1010" width="220" height="90" as="geometry" /></mxCell><mxCell id="busyw" value="LOAD_INCOMPLETE (STAGING_TABLE_BUSY)&lt;br&gt;loaded by the next run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="430" y="1025" width="280" height="60" as="geometry" /></mxCell><mxCell id="stg" value="Staging: remove the source's earlier rows of&lt;br&gt;the run type, insert the records + derived columns&lt;br&gt;LOAD_ENGINE: BATCH · FASTLOAD · AUTO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="300" height="80" as="geometry" /></mxCell><mxCell id="fb" value="FastLoad not allowed: batched inserts&lt;br&gt;in the same run (WARNING, reason&lt;br&gt;in the load message)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="1110" width="280" height="70" as="geometry" /></mxCell><mxCell id="pe" value="A value does not fit staging:&lt;br&gt;REJECTED FILE_PARSE_ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="1195" width="280" height="60" as="geometry" /></mxCell><mxCell id="typ" value="NOT NULL and type&lt;br&gt;checks to core pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="1260" width="220" height="90" as="geometry" /></mxCell><mxCell id="typr" value="REJECTED CORE_TYPE_MISMATCH&lt;br&gt;staged rows removed, core untouched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="1275" width="280" height="60" as="geometry" /></mxCell><mxCell id="core" value="One transaction: remove the batch's core rows of&lt;br&gt;the source, copy the staged rows (converted);&lt;br&gt;copied count = staged count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="300" height="80" as="geometry" /></mxCell><mxCell id="ok" value="FILE_LOADED · batch SOURCE_DATA_READY&lt;br&gt;(SOURCE_DATA_READY_NO_DATA: no rows)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="300" height="60" as="geometry" /></mxCell><mxCell id="arc" value="File → Archive/ · control report line&lt;br&gt;triggers OVERRIDE_DECISIONS, EXPORT_LOAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1590" width="300" height="60" as="geometry" /></mxCell><mxCell id="n" value="Every REJECTED file: moved to Error/, error log in&lt;br&gt;ErrorLog/, audit event (emailed); the run ends with exit 1&lt;br&gt;after all other files.&lt;br&gt;A database error at any step: PROCESS_FAILURE,&lt;br&gt;nothing half done, the file stays and is tried again." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="1480" width="320" height="110" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="ls"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ls" target="age"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg" target="bat"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stg" target="typ"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="core" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ok" target="arc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="age" target="agew"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="age" target="own"><mxGeometry