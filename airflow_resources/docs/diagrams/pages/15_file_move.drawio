<mxfile host="app.diagrams.net" agent="Government Regulatory framework" version="24.7.17"><diagram id="p14" name="15 FILE_MOVE"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="FILE_MOVE – copy and move files between folders (runbook 9.7, 11.24)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry" /></mxCell><mxCell id="s" value="FILE_MOVE DAG run&lt;br&gt;(schedule or trigger; &lt;i&gt;job&lt;/i&gt; = only these jobs)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="300" height="50" as="geometry" /></mxCell><mxCell id="cfg" value="Variable OK?&lt;br&gt;NAS connection, load_env, jobs;&lt;br&gt;only the last target a move" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="135" width="300" height="110" as="geometry" /></mxCell><mxCell id="cnr" value="COULD NOT RUN (exit 2)&lt;br&gt;task retried, then fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="240" height="60" as="geometry" /></mxCell><mxCell id="ls" value="Per job: list the source folder&lt;br&gt;(files directly in it, not subfolders)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="275" width="300" height="55" as="geometry" /></mxCell><mxCell id="pat" value="Name fits a pattern&lt;br&gt;(not case sensitive) and older&lt;br&gt;than NAS_MIN_AGE_SECONDS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="355" width="300" height="110" as="geometry" /></mxCell><mxCell id="left" value="Not taken: stays in the source&lt;br&gt;(still arriving: next run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="720" y="380" width="240" height="60" as="geometry" /></mxCell><mxCell id="tgt" value="Next target of the file, in order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="495" width="300" height="45" as="geometry" /></mxCell><mxCell id="ex" value="A file of that name&lt;br&gt;already in the target?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="565" width="300" height="90" as="geometry" /></mxCell><mxCell id="same" value="Same content?&lt;br&gt;(size + SHA-256)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="565" width="240" height="90" as="geometry" /></mxCell><mxCell id="already" value="already in … (same content)&lt;br&gt;nothing written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="580" width="220" height="60" as="geometry" /></mxCell><mxCell id="oe" value="on_exists" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="690" width="240" height="80" as="geometry" /></mxCell><mxCell id="fail" value="fail: file stays in the source;&lt;br&gt;later targets not tried;&lt;br&gt;reported, exit 1; next file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="690" width="220" height="80" as="geometry" /></mxCell><mxCell id="put" value="Copy to &amp;lt;target&amp;gt;/_file_move_tmp/&amp;lt;run id&amp;gt;_&amp;lt;name&amp;gt;,&lt;br&gt;check the size, rename to the name&lt;br&gt;rename: name_1.txt (an earlier same copy is reused)&lt;br&gt;overwrite: replace the old file&lt;br&gt;A move on the source's share: a rename" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="680" width="380" height="105" as="geometry" /></mxCell><mxCell id="more" value="More targets?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="815" width="300" height="80" as="geometry" /></mxCell><mxCell id="mv" value="Last target a move?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="930" width="300" height="80" as="geometry" /></mxCell><mxCell id="rm" value="Remove the file from the source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="1045" width="300" height="45" as="geometry" /></mxCell><mxCell id="cp" value="copied: file stays in the source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="720" y="940" width="240" height="60" as="geometry" /></mxCell><mxCell id="rep" value="Report: COMPLETED (exit 0) · COMPLETED WITH PROBLEMS&lt;br&gt;(exit 1, no retry; fail_on_problems false: success)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="1125" width="400" height="60" as="geometry" /></mxCell><mxCell id="trg" value="trigger_dags (e.g. FILE_LOAD) start only when&lt;br&gt;at least 1 file was moved or copied;&lt;br&gt;file_move_result fails the run if a file failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="290" y="1215" width="400" height="70" as="geometry" /></mxCell><mxCell id="ex1" value="&lt;b&gt;Example (runbook 9.7)&lt;/b&gt;&lt;br&gt;source OSS_Landing/…/UMCM, UMCM_*.txt&lt;br&gt;1. OSS_Backup  copy  (on_exists rename)&lt;br&gt;2. OSS_Audit  copy&lt;br&gt;3. OSS_Inbound  move&lt;br&gt;→ trigger GOVT_RGLTRY_UMCM_FILE_LOAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="280" height="130" as="geometry" /></mxCell><mxCell id="ex2" value="&lt;b&gt;Any failure&lt;/b&gt; leaves the file in the source;&lt;br&gt;targets that have it keep it. The next run&lt;br&gt;finds them &lt;i&gt;already in&lt;/i&gt; and carries on:&lt;br&gt;no duplicates. No file data in the log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="1040" width="260" height="90" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="cfg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfg" target="cnr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfg" target="ls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="cannot list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ls" target="cnr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="each file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ls" target="pat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="left"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="tgt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tgt" target="ex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="same"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="put"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="same" target="already"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="same" target="oe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="oe" target="fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="rename / overwrite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="oe" target="put"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="already" target="more"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="610" 