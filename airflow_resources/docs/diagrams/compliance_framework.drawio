<diagram id="p12" name="13 Batch lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="The life of a batch – one row per batch and source (runbook 3)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="bc" value="BATCH_CREATION" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="70" width="220" height="50" as="geometry"/></mxCell><mxCell id="rc" value="REQUEST_CREATED" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="160" width="220" height="60" as="geometry"/></mxCell><mxCell id="sdr" value="SOURCE_DATA_READY" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="260" height="60" as="geometry"/></mxCell><mxCell id="sdn" value="SOURCE_DATA_READY_NO_DATA" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="330" width="260" height="60" as="geometry"/></mxCell><mxCell id="sdc" value="SOURCE_DATA_CARRY_FORWARD" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="260" height="60" as="geometry"/></mxCell><mxCell id="c1" value="REQUEST_COMPLETE&lt;br&gt;(NEW_FILE)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="260" height="60" as="geometry"/></mxCell><mxCell id="c2" value="DATA_NOT_PROVIDED&lt;br&gt;(NO_DATA)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="370" y="490" width="260" height="60" as="geometry"/></mxCell><mxCell id="c3" value="REQUEST_COMPLETE&lt;br&gt;(CARRY_FORWARD)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="260" height="60" as="geometry"/></mxCell><mxCell id="c4" value="DATA_NOT_PROVIDED (MISSING)&lt;br&gt;+ SOURCE_MISSING_AT_CLOSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1030" y="490" width="260" height="60" as="geometry"/></mxCell><mxCell id="n" value="No rows = a file with no rows, or a pull with no rows on / after the close date.&lt;br&gt;Close date = Req_Dt_Key + SLA_Days − 1; BATCH_CLOSE closes on its first run on or after it. Green = final (closed).&lt;br&gt;Closed batch + approved LATE_ARRIVAL / CORRECTION: the file loads, the batch stays closed.&lt;br&gt;Closed batch + approved REOPEN: OVERRIDE_DECISIONS opens it again until new data, then BATCH_CLOSE closes it again." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1250" height="85" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bc" target="rc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="file / pull with data rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rc" target="sdr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="434" y="270"/><mxPoint x="170" y="270"/></Array></mxGeometry></mxCell><mxCell id="e2" value="no rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rc" target="sdn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="approved REUSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rc" target="sdc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="566" y="270"/><mxPoint x="830" y="270"/></Array></mxGeometry></mxCell><mxCell id="e4" value="REUSE expired / rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdc" target="rc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="360"/><mxPoint x="990" y="190"/></Array></mxGeometry></mxCell><mxCell id="e5" value="BATCH_CLOSE: nothing arrived" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rc" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="190"/></Array></mxGeometry></mxCell><mxCell id="e6" value="BATCH_CLOSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdr" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="BATCH_CLOSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdn" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="BATCH_CLOSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sdc" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
