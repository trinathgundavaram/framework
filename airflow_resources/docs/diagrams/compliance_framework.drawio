<diagram id="p7" name="8 OVERRIDE_DECISIONS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="OVERRIDE_DECISIONS – approved overrides (runbook 2.7, 6.2)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="s" value="OVERRIDE_DECISIONS run (scope)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="280" height="50" as="geometry"/></mxCell><mxCell id="r1" value="REUSE approved and valid,&lt;br&gt;batch open, run type Carry_Fwd_Ind = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="290" height="70" as="geometry"/></mxCell><mxCell id="r2" value="Carry forward: the batch takes the data of&lt;br&gt;the earlier closed batch&lt;br&gt;SOURCE_DATA_CARRY_FORWARD&lt;br&gt;(CARRY_FORWARD_APPLIED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="290" height="95" as="geometry"/></mxCell><mxCell id="r3" value="Cannot apply: OVERRIDE_INVALID_DETECTED&lt;br&gt;(emailed); the task still succeeds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="290" height="60" as="geometry"/></mxCell><mxCell id="o1" value="REOPEN approved&lt;br&gt;for a closed batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="280" height="70" as="geometry"/></mxCell><mxCell id="o2" value="Batch opened again (BATCH_REOPENED)&lt;br&gt;until new data arrives, then closed&lt;br&gt;again by BATCH_CLOSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="280" height="80" as="geometry"/></mxCell><mxCell id="x1" value="Carried-forward batch whose REUSE&lt;br&gt;expired or was rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="710" y="170" width="280" height="70" as="geometry"/></mxCell><mxCell id="x2" value="Back to REQUEST_CREATED&lt;br&gt;(CARRY_FORWARD_REMOVED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="280" width="280" height="80" as="geometry"/></mxCell><mxCell id="n" value="A batch another run is working on: left for the next run (logged).&lt;br&gt;LATE_ARRIVAL / CORRECTION are not applied here: FILE_LOAD uses them when the file arrives." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="610" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="o1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitD