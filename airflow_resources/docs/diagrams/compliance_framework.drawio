<diagram id="p8" name="9 EXPORT_LOAD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="EXPORT_LOAD – core to the export table (runbook 2.8, 5.11)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="s" value="EXPORT_LOAD run (scope, batch, release, hold)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="320" height="50" as="geometry"/></mxCell><mxCell id="sel" value="Batches: every open batch of the scope (each run),&lt;br&gt;closed batches with new data since their last&lt;br&gt;export (late arrival, correction), or the batches named" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="320" height="80" as="geometry"/></mxCell><mxCell id="due" value="Due (close date, RELEASE_TIME)&lt;br&gt;or released, run type&lt;br&gt;not held?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="270" width="220" height="100" as="geometry"/></mxCell><mxCell id="held" value="held: listed in the report,&lt;br&gt;exported when due or released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="440" y="290" width="280" height="60" as="geometry"/></mxCell><mxCell id="new" value="Newest batch of its period&lt;br&gt;(NEW_FILE / CARRY_FORWARD&lt;br&gt;/ NO_DATA)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="410" width="220" height="100" as="geometry"/></mxCell><mxCell id="sk" value="SKIPPED: the period&#x27;s data&lt;br&gt;is another batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="430" width="280" height="60" as="geometry"/></mxCell><mxCell id="pre" value="Exp_Pre_Sql_Txt (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="320" height="50" as="geometry"/></mxCell><mxCell id="how" value="How is it exported?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="640" width="220" height="90" as="geometry"/></mxCell><mxCell id="m1" value="Procedure Exp_Proc_Nm&lt;br&gt;CALL with Exp_Proc_Parm_Txt;&lt;br&gt;it deletes and inserts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="240" height="80" as="geometry"/></mxCell><mxCell id="m2" value="Exp_Sql_Txt SELECT:&lt;br&gt;the source&#x27;s period rows removed,&lt;br&gt;the SELECT&#x27;s rows inserted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="780" width="240" height="80" as="geometry"/></mxCell><mxCell id="m3" value="Plain copy: the source&#x27;s period rows&lt;br&gt;removed, the batch&#x27;s core rows&lt;br&gt;inserted (columns mapped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="780" width="240" height="80" as="geometry"/></mxCell><mxCell id="post" value="Exp_Post_Sql_Txt (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="320" height="50" as="geometry"/></mxCell><mxCell id="ok" value="Succeeded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="990" width="220" height="90" as="geometry"/></mxCell><mxCell id="bad" value="Rolled back: EXPORT_LOAD_FAILED&lt;br&gt;(emailed), exit 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="440" y="1005" width="280" height="60" as="geometry"/></mxCell><mxCell id="done" value="EXPORT_LOADED in the timeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="320" height="50" as="geometry"/></mxCell><mxCell id="ru" value="trigger FILE_RULES (and wait for it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="320" height="50" as="geometry"/></mxCell><mxCell id="n" value="Pre, every source&#x27;s export and post run as one transaction per batch.&lt;br&gt;A source without data yet: its earlier rows of the period are removed, none inserted&lt;br&gt;(with a procedure, the procedure is called for it)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1110" width="460" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="sel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sel" target="due"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="due" target="held"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="due" target="new"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="new" target="sk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="new" target="pre"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pre" target="how"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Exp_Proc_Nm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="how" target="m1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="685"/></Array></mxGeometry></mxCell><mxCell id="e8" value="Exp_Sql_Txt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="how" target="m2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="755"/><mxPoint x="410" y="755"/></Array></mxGeometry></mxCell><mxCell id="e9" value="neither" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="how" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="post"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2" target="post"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m3" target="post"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="925"/></Array></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="post" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ok" target="bad"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ok" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="done" target="ru"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="p9" name="10 FILE_RULES"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FILE_RULES – data quality rules of each exported batch (runbook 2.12)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="s" value="FILE_RULES run (scope), pool gre_rules" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="50" as="geometry"/></mxCell><mxCell id="sel" value="Loads FILE_LOADED whose Rules_Stat is&lt;br&gt;NOT_RUN or ERROR, by batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="60" as="geometry"/></mxCell><mxCell id="exp" value="Table has an export:&lt;br&gt;batch exported since&lt;br&gt;the load?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="220" height="100" as="geometry"/></mxCell><mxCell id="expw" value="waiting for EXPORT_LOAD (logged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="430" y="270" width="280" height="60" as="geometry"/></mxCell><mxCell id="lk" value="Batch free?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="220" height="90" as="geometry"/></mxCell><mxCell id="lkw" value="left for the next run (logged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="430" y="405" width="280" height="60" as="geometry"/></mxCel