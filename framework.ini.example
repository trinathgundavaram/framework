; CMS compliance framework - sample configuration file.
; Copy to framework.ini (or point FRAMEWORK_CONFIG_FILE at it).
; Precedence: environment (FRAMEWORK_*) > this file > metadata tables > built-in defaults.
; Do not commit real passwords: prefer secret_name or password_env.

[settings]
; bootstrap values (environment or this file only)
metadata_schema = cms_compliance
aws_region = us-east-1
; any runtime setting may be set here; it then overrides ComplianceFrameworkSetting
; object_store = local
; local_store_root = ./.local_store
; rule_engine = none

[metadata_db]
; either a DSN ...
; dsn = postgresql://framework_app@localhost:5432/framework
; ... or individual keys (explicit keys override DSN values)
host = localhost
port = 5432
dbname = framework
user = framework_app
; name of an environment variable that holds the password:
; password_env = FRAMEWORK_DB_PASSWORD_VALUE
; Secrets Manager secret (JSON: host, port, dbname, username, password):
; secret_name = framework/metadata-db
sslmode = prefer

; Optional overrides for a data connection registered in ComplianceDbConnection
; (section name = Connection_Nm; same keys as [metadata_db]).
; [connection:PRJA_DW]
; host = localhost
; dbname = prja
; password_env = PRJA_DW_PASSWORD
