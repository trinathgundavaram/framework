{
  "compliance_batch_framework: a named run of the Variable": {
    "run": "odr_full_cycle"
  },
  "compliance_batch_framework: a named run for a missed day": {
    "run": "odr_full_cycle",
    "as_of": "2026-09-01"
  },
  "compliance_batch_framework: parameters given directly": {
    "project": "UNIVERSE",
    "steps": ["BATCH_CREATION", "FILE_LOAD"],
    "run_type": "MONTHLY",
    "period": "PREV_CALENDAR_MONTH"
  },
  "compliance_batch_framework: one table, rules annotated instead of gating": {
    "project": "ODR",
    "steps": ["FILE_LOAD", "NOTIFY"],
    "table": "ROPENS",
    "settings": {"FILE_RULES_MODE": "ANNOTATE"}
  },
  "compliance_batch_framework: another environment's Variable": {
    "variable_key": "compliance_framework_config_qa",
    "run": "odr_full_cycle"
  },
  "any scheduled DAG: re-run for a past date": {
    "as_of": "2026-09-01"
  },
  "compliance_admin: check the configuration": {
    "command": "validate-config"
  },
  "compliance_admin: close a batch without data": {
    "command": "close-batch",
    "args": ["--btch-id", "20260901_ODR_ROPENS_50_DAILY_2026_1", "--closed-by", "jdoe"]
  },
  "compliance_admin: list locks, release one left by a crashed run": {
    "command": "release-lock",
    "args": ["--key", "BTCH:20260901_ODR_ROPENS_50_DAILY_2026_1"]
  }
}
