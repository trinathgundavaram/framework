{
  "td_conn_var": "compliance_teradata_dev",
  "wdc_comp_oper_nas_var": "wdc_comp_oper_nas_dev",
  "meta_db": "CMS_COMPLIANCE_DEV",
  "load_env": "DEV",
  "load_duplicate": "no",
  "email_recipient": "compliance-dev@example.com",
  "owner": "oss",
  "snow_assignment_group": "D&AE - EDE Govt Compliance",
  "tags": [
    "Compliance",
    "Compliance_Batch_Framework"
  ],
  "log_level": "DEBUG",
  "schedule_timezone": "America/Chicago",
  "settings": {
    "OBJECT_STORE": "nas",
    "ARCHIVE_FOLDER": "Archive",
    "NAS_MIN_AGE_SECONDS": 120,
    "BUSINESS_TZ": "America/Chicago",
    "NOTIFY_BACKEND": "log",
    "DEFAULT_NOTIFY_EMAILS": "compliance-dev@example.com",
    "RULE_ENGINE": "none",
    "LOCK_TTL_MINUTES": 60
  },
  "runs": {
    "odr_file_load": {
      "schedule_interval": "0 * * * *",
      "project": "ODR",
      "steps": [
        "FILE_LOAD",
        "OVERRIDE_DECISIONS",
        "NOTIFY"
      ]
    },
    "odr_full_cycle": {
      "project": "ODR",
      "steps": [
        "BATCH_CREATION",
        "FILE_LOAD",
        "OVERRIDE_DECISIONS",
        "BATCH_CLOSE",
        "NOTIFY"
      ],
      "run_type": "DAILY",
      "period": "PREV_DAY"
    }
  }
}
