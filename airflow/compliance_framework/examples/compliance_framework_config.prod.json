{
  "connection_id": "compliance_teradata",
  "meta_db": "CMS_COMPLIANCE_PROD",
  "log_level": "INFO",
  "schedule_timezone": "America/Chicago",
  "settings": {
    "QUARANTINE_URI": "s3://REPLACE_WITH_PROD_INBOUND_BUCKET/quarantine/",
    "BUSINESS_TZ": "America/Chicago",
    "AWS_REGION": "us-east-1",
    "NOTIFY_BACKEND": "airflow",
    "DEFAULT_NOTIFY_EMAILS": "compliance-ops@example.com",
    "FILE_RULES_MODE": "GATE",
    "RULE_ENGINE": "gre",
    "GRE_ENTRYPOINT": "compliance_framework.gre_bridge:run_gre",
    "LOCK_TTL_MINUTES": 240
  },
  "gre": {
    "environment": "PROD",
    "meta_db": "GRE_META_PROD"
  },
  "fail_on_problems": {
    "FILE_LOAD": false,
    "OVERRIDE_DECISIONS": false
  },
  "runs": {
    "odr_daily_batches": {
      "schedule": "0 6 * * *",
      "project": "ODR",
      "steps": ["BATCH_CREATION"],
      "run_type": "DAILY",
      "period": "PREV_DAY",
      "alert_emails": ["odr-team@example.com"]
    },
    "odr_file_load": {
      "schedule": "*/15 * * * *",
      "project": "ODR",
      "steps": ["FILE_LOAD", "OVERRIDE_DECISIONS", "NOTIFY"],
      "alert_emails": ["odr-team@example.com"]
    },
    "odr_close": {
      "schedule": "0 * * * *",
      "project": "ODR",
      "steps": ["BATCH_CLOSE", "NOTIFY"],
      "alert_emails": ["odr-team@example.com"]
    },
    "universe_monthly_batches": {
      "schedule": "0 6 1 * *",
      "project": "UNIVERSE",
      "steps": ["BATCH_CREATION"],
      "run_type": "MONTHLY",
      "period": "PREV_CALENDAR_MONTH",
      "alert_emails": ["universe-team@example.com"]
    },
    "universe_weekly_batches": {
      "schedule": "0 6 * * 1",
      "project": "UNIVERSE",
      "steps": ["BATCH_CREATION"],
      "run_type": "WEEKLY",
      "period": "PREV_CALENDAR_WEEK",
      "alert_emails": ["universe-team@example.com"]
    },
    "universe_daily_batches": {
      "schedule": "0 6 * * *",
      "project": "UNIVERSE",
      "steps": ["BATCH_CREATION"],
      "run_type": "CMS",
      "period": "CURRENT_CALENDAR_MONTH",
      "alert_emails": ["universe-team@example.com"]
    },
    "universe_file_load": {
      "schedule": "5-59/15 * * * *",
      "project": "UNIVERSE",
      "steps": ["FILE_LOAD", "OVERRIDE_DECISIONS", "NOTIFY"],
      "settings": {"FILE_RULES_MODE": "ANNOTATE"},
      "alert_emails": ["universe-team@example.com"]
    },
    "universe_close": {
      "schedule": "30 23 * * *",
      "project": "UNIVERSE",
      "steps": ["BATCH_CLOSE", "NOTIFY"],
      "alert_emails": ["universe-team@example.com"]
    },
    "all_projects_notify": {
      "schedule": "0 * * * *",
      "steps": ["NOTIFY"]
    },
    "odr_full_cycle": {
      "project": "ODR",
      "steps": ["BATCH_CREATION", "FILE_LOAD", "OVERRIDE_DECISIONS", "BATCH_CLOSE", "NOTIFY"],
      "run_type": "DAILY",
      "period": "PREV_DAY"
    }
  }
}
