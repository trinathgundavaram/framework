{
  "td_conn_var": "compliance_teradata",
  "wdc_comp_oper_nas_var": "wdc_comp_oper_nas",
  "meta_db": "CMS_COMPLIANCE_PROD",
  "load_env": "PROD",
  "load_duplicate": "no",
  "email_recipient": "compliance-ops@example.com",
  "owner": "oss",
  "snow_assignment_group": "D&AE - EDE Govt Compliance",
  "tags": [
    "Compliance",
    "Compliance_Batch_Framework"
  ],
  "log_level": "INFO",
  "schedule_timezone": "America/Chicago",
  "settings": {
    "OBJECT_STORE": "nas",
    "ARCHIVE_FOLDER": "Archive",
    "NAS_MIN_AGE_SECONDS": 120,
    "BUSINESS_TZ": "America/Chicago",
    "NOTIFY_BACKEND": "airflow",
    "DEFAULT_NOTIFY_EMAILS": "compliance-ops@example.com",
    "FILE_RULES_MODE": "GATE",
    "RULE_ENGINE": "gre",
    "GRE_ENTRYPOINT": "compliance_framework.gre_bridge:run_gre",
    "LOCK_TTL_MINUTES": 240
  },
  "gre": {
    "environment": "PROD",
    "meta_db": "GRE_META_PROD"
  },
  "fail_on_problems": {
    "FILE_LOAD": false,
    "OVERRIDE_DECISIONS": false
  },
  "runs": {
    "odr_daily_batches": {
      "schedule_interval": "0 6 * * *",
      "project": "ODR",
      "steps": [
        "BATCH_CREATION"
      ],
      "run_type": "DAILY",
      "period": "PREV_DAY",
      "email_recipient": "odr-team@example.com"
    },
    "odr_file_load": {
      "schedule_interval": "*/15 * * * *",
      "project": "ODR",
      "steps": [
        "FILE_LOAD",
        "OVERRIDE_DECISIONS",
        "NOTIFY"
      ],
      "email_recipient": "odr-team@example.com"
    },
    "odr_close": {
      "schedule_interval": "0 * * * *",
      "project": "ODR",
      "steps": [
        "BATCH_CLOSE",
        "NOTIFY"
      ],
      "email_recipient": "odr-team@example.com"
    },
    "universe_monthly_batches": {
      "schedule_interval": "0 6 1 * *",
      "project": "UNIVERSE",
      "steps": [
        "BATCH_CREATION"
      ],
      "run_type": "MONTHLY",
      "period": "PREV_CALENDAR_MONTH",
      "email_recipient": "universe-team@example.com"
    },
    "universe_weekly_batches": {
      "schedule_interval": "0 6 * * 1",
      "project": "UNIVERSE",
      "steps": [
        "BATCH_CREATION"
      ],
      "run_type": "WEEKLY",
      "period": "PREV_CALENDAR_WEEK",
      "email_recipient": "universe-team@example.com"
    },
    "universe_daily_batches": {
      "schedule_interval": "0 6 * * *",
      "project": "UNIVERSE",
      "steps": [
        "BATCH_CREATION"
      ],
      "run_type": "CMS",
      "period": "CURRENT_CALENDAR_MONTH",
      "email_recipient": "universe-team@example.com"
    },
    "universe_file_load": {
      "schedule_interval": "5-59/15 * * * *",
      "project": "UNIVERSE",
      "steps": [
        "FILE_LOAD",
        "OVERRIDE_DECISIONS",
        "NOTIFY"
      ],
      "settings": {
        "FILE_RULES_MODE": "ANNOTATE"
      },
      "email_recipient": "universe-team@example.com"
    },
    "universe_close": {
      "schedule_interval": "30 23 * * *",
      "project": "UNIVERSE",
      "steps": [
        "BATCH_CLOSE",
        "NOTIFY"
      ],
      "email_recipient": "universe-team@example.com"
    },
    "all_projects_notify": {
      "schedule_interval": "0 * * * *",
      "steps": [
        "NOTIFY"
      ]
    },
    "odr_full_cycle": {
      "project": "ODR",
      "steps": [
        "BATCH_CREATION",
        "FILE_LOAD",
        "OVERRIDE_DECISIONS",
        "BATCH_CLOSE",
        "NOTIFY"
      ],
      "run_type": "DAILY",
      "period": "PREV_DAY"
    }
  }
}
