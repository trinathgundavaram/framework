# CMS compliance framework - local settings. Copy to .env (git-ignored) or point FRAMEWORK_ENV_FILE at a copy.
# Precedence: --set NAME=VALUE job arguments > environment variables > this file > built-in defaults.
# In AWS there is no .env: set FRAMEWORK_DB_SECRET_NAME and pass project settings as Glue job arguments.

# --- database (one PostgreSQL database: metadata schema + staging/core tables) ---
FRAMEWORK_DB_HOST=localhost
FRAMEWORK_DB_PORT=5432
FRAMEWORK_DB_NAME=framework
FRAMEWORK_DB_USER=framework_app
FRAMEWORK_DB_PASSWORD=change-me
FRAMEWORK_DB_SSLMODE=prefer
# or: FRAMEWORK_DB_DSN=postgresql://framework_app:change-me@localhost:5432/framework
# AWS: FRAMEWORK_DB_SECRET_NAME=cms-compliance/dev/postgres
FRAMEWORK_METADATA_SCHEMA=cms_compliance

# --- local development ---
FRAMEWORK_OBJECT_STORE=local
FRAMEWORK_LOCAL_STORE_ROOT=./.local_store
FRAMEWORK_RULE_ENGINE=none
FRAMEWORK_BUSINESS_TZ=America/Chicago

# --- project job settings (normally passed per scheduled job with --set) ---
# FRAMEWORK_LOAD_ENGINE=PANDAS
# FRAMEWORK_FILE_RULES_MODE=GATE
# FRAMEWORK_QUARANTINE_URI=s3://my-quarantine-bucket/cms-compliance/
# FRAMEWORK_NOTIFY_BACKEND=ses
# FRAMEWORK_NOTIFY_FROM_EMAIL=noreply@example.com
# FRAMEWORK_DEFAULT_NOTIFY_EMAILS=ops@example.com
